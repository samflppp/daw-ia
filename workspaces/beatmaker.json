{
  "$schema": "./schema/workspace.schema.json",
  "schemaVersion": 1,
  "id": "beatmaker",
  "label": "Beatmaker",
  "description": "Production de beats : transport, navigateur de samples, playlist, channel rack, piano roll, chaîne de plugins, historique, copilote.",
  "panels": [
    "transport",
    "tracks",
    "browser",
    "playlist",
    "canvas",
    "channel_rack",
    "piano_roll",
    "plugin_chain",
    "mixer",
    "history",
    "direction",
    "audio",
    "flux",
    "copilot"
  ],
  "layout": {
    "bar": [
      "transport"
    ],
    "pages": [
      {
        "panel": "browser",
        "title": "Navigateur",
        "open": true,
        "x": 0,
        "y": 0,
        "width": 0.18,
        "height": 1
      },
      {
        "panel": "playlist",
        "title": "Playlist",
        "shortcut": "F5",
        "open": false,
        "x": 0.18,
        "y": 0,
        "width": 0.57,
        "height": 0.62
      },
      {
        "panel": "canvas",
        "title": "Toile",
        "shortcut": "F4",
        "open": true,
        "x": 0.18,
        "y": 0,
        "width": 0.57,
        "height": 0.62
      },
      {
        "panel": "channel_rack",
        "title": "Channel rack",
        "shortcut": "F6",
        "open": true,
        "x": 0.18,
        "y": 0.62,
        "width": 0.57,
        "height": 0.38
      },
      {
        "panel": "piano_roll",
        "title": "Piano roll",
        "shortcut": "F7",
        "open": false,
        "x": 0.18,
        "y": 0,
        "width": 0.57,
        "height": 0.62
      },
      {
        "panel": "plugin_chain",
        "title": "Plugins",
        "shortcut": "F8",
        "open": false,
        "x": 0.5,
        "y": 0.1,
        "width": 0.3,
        "height": 0.6
      },
      {
        "panel": "mixer",
        "title": "Mixer",
        "shortcut": "F10",
        "open": false,
        "x": 0.05,
        "y": 0.3,
        "width": 0.9,
        "height": 0.7
      },
      {
        "panel": "tracks",
        "title": "Pistes",
        "shortcut": "F9",
        "open": false,
        "x": 0.05,
        "y": 0.15,
        "width": 0.4,
        "height": 0.7
      },
      {
        "panel": "direction",
        "title": "Direction",
        "shortcut": "F11",
        "open": false,
        "x": 0.45,
        "y": 0.1,
        "width": 0.3,
        "height": 0.6
      },
      {
        "panel": "flux",
        "title": "Flux audio",
        "shortcut": "F3",
        "open": false,
        "x": 0.05,
        "y": 0.08,
        "width": 0.9,
        "height": 0.84
      },
      {
        "panel": "audio",
        "title": "Audio",
        "shortcut": "F12",
        "open": false,
        "x": 0.35,
        "y": 0.15,
        "width": 0.32,
        "height": 0.55
      },
      {
        "panel": "history",
        "title": "Historique",
        "open": true,
        "x": 0.75,
        "y": 0,
        "width": 0.25,
        "height": 0.35
      },
      {
        "panel": "copilot",
        "title": "Copilote",
        "open": true,
        "x": 0.75,
        "y": 0.35,
        "width": 0.25,
        "height": 0.65
      }
    ]
  },
  "commands": [
    "transport.play",
    "transport.stop",
    "transport.set_position",
    "project.undo",
    "project.redo",
    "track.add",
    "track.remove",
    "track.set_volume",
    "track.set_muted",
    "clip.create_midi",
    "note.add",
    "note.remove",
    "note.move",
    "note.resize",
    "plugin.insert",
    "plugin.remove",
    "plugin.move",
    "plugin.set_bypassed",
    "track.set_pan",
    "track.rename",
    "note.quantize",
    "note.transpose",
    "note.set_velocity",
    "tempo.set_bpm",
    "transport.set_loop",
    "plugin.set_parameter",
    "pattern.create",
    "pattern.place",
    "pattern.add_track",
    "pattern.set_length",
    "track.set_channel_pitch",
    "pattern.rename",
    "pattern.remove",
    "placement.move",
    "placement.remove",
    "transport.set_mode",
    "track.set_sample",
    "audio.place",
    "audio.move",
    "audio.remove",
    "bus.add",
    "track.set_output",
    "track.set_send",
    "track.remove_send",
    "track.set_solo",
    "track.set_role"
  ],
  "services": [
    "mcp",
    "harmony",
    "ia_provider"
  ]
}
