{
  "$schema": "./schema/workspace.schema.json",
  "schemaVersion": 1,
  "id": "beatmaker",
  "label": "Beatmaker",
  "description": "Production de beats : transport, pistes, playlist, channel rack, piano roll, chaîne de plugins, historique, copilote.",
  "panels": [
    "transport",
    "tracks",
    "playlist",
    "channel_rack",
    "piano_roll",
    "plugin_chain",
    "history",
    "copilot"
  ],
  "layout": {
    "bar": [
      "transport"
    ],
    "pages": [
      {
        "panel": "playlist",
        "title": "Playlist",
        "shortcut": "F5",
        "open": true,
        "x": 0,
        "y": 0,
        "width": 0.66,
        "height": 0.55
      },
      {
        "panel": "channel_rack",
        "title": "Channel rack",
        "shortcut": "F6",
        "open": true,
        "x": 0,
        "y": 0.55,
        "width": 0.66,
        "height": 0.45
      },
      {
        "panel": "piano_roll",
        "title": "Piano roll",
        "shortcut": "F7",
        "open": false,
        "x": 0.08,
        "y": 0.08,
        "width": 0.72,
        "height": 0.8
      },
      {
        "panel": "plugin_chain",
        "title": "Plugins",
        "shortcut": "F8",
        "open": false,
        "x": 0.5,
        "y": 0.1,
        "width": 0.3,
        "height": 0.6
      },
      {
        "panel": "tracks",
        "title": "Pistes",
        "shortcut": "F9",
        "open": false,
        "x": 0.05,
        "y": 0.15,
        "width": 0.4,
        "height": 0.7
      },
      {
        "panel": "history",
        "title": "Historique",
        "open": true,
        "x": 0.66,
        "y": 0,
        "width": 0.34,
        "height": 0.35
      },
      {
        "panel": "copilot",
        "title": "Copilote",
        "open": true,
        "x": 0.66,
        "y": 0.35,
        "width": 0.34,
        "height": 0.65
      }
    ]
  },
  "commands": [
    "transport.play",
    "transport.stop",
    "transport.set_position",
    "project.undo",
    "project.redo",
    "track.add",
    "track.remove",
    "track.set_volume",
    "track.set_muted",
    "clip.create_midi",
    "note.add",
    "note.remove",
    "note.move",
    "note.resize",
    "plugin.insert",
    "plugin.remove",
    "plugin.set_bypassed",
    "track.set_pan",
    "track.rename",
    "note.quantize",
    "note.transpose",
    "note.set_velocity",
    "tempo.set_bpm",
    "transport.set_loop",
    "plugin.set_parameter",
    "pattern.create",
    "pattern.place",
    "pattern.add_track",
    "pattern.set_length",
    "track.set_channel_pitch",
    "pattern.rename",
    "pattern.remove",
    "placement.move",
    "placement.remove",
    "transport.set_mode"
  ],
  "services": [
    "mcp",
    "harmony",
    "ia_provider"
  ]
}
