{
  "$schema": "./schema/workspace.schema.json",
  "schemaVersion": 1,
  "id": "beatmaker",
  "label": "Beatmaker",
  "description": "Production de beats : transport, pistes, piano roll, chaîne de plugins, historique, copilote.",
  "panels": [
    "transport",
    "tracks",
    "piano_roll",
    "plugin_chain",
    "history",
    "copilot"
  ],
  "layout": {
    "split": "vertical",
    "children": [
      {
        "panel": "transport",
        "weight": 1
      },
      {
        "split": "horizontal",
        "weight": 9,
        "children": [
          {
            "panel": "tracks",
            "weight": 3
          },
          {
            "panel": "piano_roll",
            "weight": 9
          },
          {
            "split": "vertical",
            "weight": 3,
            "children": [
              {
                "panel": "plugin_chain",
                "weight": 2
              },
              {
                "panel": "history",
                "weight": 2
              },
              {
                "panel": "copilot",
                "weight": 3
              }
            ]
          }
        ]
      }
    ]
  },
  "commands": [
    "transport.play",
    "transport.stop",
    "transport.set_position",
    "project.undo",
    "project.redo",
    "track.add",
    "track.remove",
    "track.set_volume",
    "track.set_muted",
    "clip.create_midi",
    "note.add",
    "note.remove",
    "note.move",
    "note.resize",
    "plugin.insert",
    "plugin.remove",
    "plugin.set_bypassed",
    "track.set_pan",
    "track.rename",
    "note.quantize",
    "note.transpose",
    "note.set_velocity",
    "tempo.set_bpm",
    "transport.set_loop",
    "plugin.set_parameter"
  ],
  "services": [
    "mcp",
    "harmony",
    "ia_provider"
  ]
}
